                    local argsGet = {
                        [1] = "PickingTools",
                        [2] = "Couch"
                    }
                    game:GetService("ReplicatedStorage").RE:FindFirstChild("1Too1l"):InvokeServer(unpack(argsGet))
                    task.wait(0.0001)

                    local tool = player.Backpack:FindFirstChild("Couch")
                    if tool then
                        tool.Parent = char
                    end
                    task.wait(0.0001)

                    workspace.FallenPartsDestroyHeight = -999999

                    local handle = tool:FindFirstChild("Handle")
                    if handle and handle:FindFirstChild("FlingForce") then
                        handle.FlingForce:Destroy()
                    end

                    -- 3. Cria a força na Handle do Sofá (Sem soltar da mão)
