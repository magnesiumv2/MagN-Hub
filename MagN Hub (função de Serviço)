            tool.Parent = char
        end
        task.wait(0.01)

        -- Define a altura de destruição para um valor gigante para o sofá não sumir antes da hora
        workspace.FallenPartsDestroyHeight = -999999

        local handle = tool and tool:FindFirstChild("Handle")
        if handle and handle:FindFirstChild("FlingForce") then
            handle.FlingForce:Destroy()
        end

        -- 3. Cria a força na Handle do Sofá para a perseguição
        local bv = nil
        if handle then
            handle.CanCollide = false
            bv = Instance.new("BodyVelocity")
            bv.Name = "FlingForce"
            bv.Velocity = Vector3.new(9e8, 9e8, 9e8)
            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bv.Parent = handle
        end
        
        hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
        hum.PlatformStand = false

        workspace.CurrentCamera.CameraSubject = target.Character:FindFirstChild("Head") or tRoot
        task.wait(0.01)

        local angle = 0
        -- Loop interno do ataque (Segue colado até capturar)
        while target and target.Character and target.Character:FindFirstChildOfClass("Humanoid") and handle and handle:IsDescendantOf(workspace) do
            local currentHum = target.Character:FindFirstChildOfClass("Humanoid")
            
            if not currentHum or currentHum.Sit or currentHum.Health <= 0 then break end
            
            angle = (angle + 50) % 360

            local pos_x = target.Character.HumanoidRootPart.Position.X
            local pos_y = target.Character.HumanoidRootPart.Position.Y
            local pos_z = target.Character.HumanoidRootPart.Position.Z
            pos_x = pos_x + (target.Character.HumanoidRootPart.Velocity.X / 1.5)
            pos_y = pos_y + (target.Character.HumanoidRootPart.Velocity.Y / 1.5)
            pos_z = pos_z + (target.Character.HumanoidRootPart.Velocity.Z / 1.5)
            
            handle.CFrame = CFrame.new(pos_x, pos_y, pos_z) * CFrame.Angles(math.rad(angle), math.rad(angle), 0)
            handle.Velocity = Vector3.new(9e8, 9e8, 9e8)
            handle.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
            task.wait()
        end
        
        -- =============================================================================
        -- [AÇÃO COMPORTAMENTAL: KILL INSTANTÂNEO NO VOID]
        -- =============================================================================
        if tHum and tHum.Sit and handle then
            -- Para o Fling imediatamente para o alvo ficar estático no sofá
            if bv then bv:Destroy() end
            handle.Velocity = Vector3.zero
            handle.RotVelocity = Vector3.zero
            task.wait(0.01)

            -- Teleporta o sofá e você para milímetros antes da zona de morte (-498)
            local voidCFrame = CFrame.new(target.Character.HumanoidRootPart.Position.X, -498, target.Character.HumanoidRootPart.Position.Z)
            root.CFrame = voidCFrame
            handle.CFrame = voidCFrame
            task.wait(0.02)

            -- Ativa a propriedade de morte por Void nativa do Roblox de volta para -500.
            -- Como ele está em Y = -498 (milímetros acima), o motor do jogo mata ele de forma limpa e instantânea.
            workspace.FallenPartsDestroyHeight = -500
            task.wait(0.2) -- Espera o servidor registrar o Kill dele
            
            if tool then tool:Destroy() end
        end
        
        -- --- ROTINA DE RECUPERAÇÃO DO SEU REPOSITÓRIO ---
        if hum then
            hum:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
            hum.PlatformStand = false
            hum:UnequipTools()
        end
        
        if char and root and originalCFrame then
            -- Passo 1: Congela
            for _, part in pairs(char:GetChildren()) do
                if part:IsA("BasePart") then
                    part.Anchored = true
                    part.Velocity = Vector3.zero
                    part.RotVelocity = Vector3.zero
                end
            end
            task.wait(0.05)
            
            -- Passo 2: Descongela
            for _, part in pairs(char:GetChildren()) do
                if part:IsA("BasePart") then
                    part.Anchored = false
                end
            end
            task.wait(0.01)
            
            -- Passo 3: Teleporta de volta para cima
            root.CFrame = originalCFrame
        end
        
        workspace.CurrentCamera.CameraSubject = hum
    end)
end

