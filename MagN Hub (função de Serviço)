local function toggleBlackHole()
    blackHoleActive = not blackHoleActive
    if blackHoleActive then
        Button.Text = "PARANDO | ON 🔥"
        Button.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
        
        -- Força TODAS as partes do mapa
        for _, v in ipairs(Workspace:GetDescendants()) do
            ForcePart(v)
        end

        DescendantAddedConnection = Workspace.DescendantAdded:Connect(function(v)
            if blackHoleActive then
                task.spawn(function()
                    ForcePart(v)
                end)
            end
        end)

        -- Atualização super rápida
        updateConnection = RunService.RenderStepped:Connect(function()
            if blackHoleActive and humanoidRootPart then
                Attachment1.WorldCFrame = humanoidRootPart.CFrame
                -- Boost extra de velocidade
                NetworkAggressive.Velocity = Vector3.new(aggressiveSpeed, aggressiveSpeed, aggressiveSpeed)
            end
        end)
    else
        Button.Text = "INICIAR | OFF"
        Button.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
        if DescendantAddedConnection then
            DescendantAddedConnection:Disconnect()
        end
        if updateConnection then
            updateConnection:Disconnect()
        end
    end
end

local function getPlayer(name)
    local lowerName = string.lower(name)
    for _, p in pairs(Players:GetPlayers()) do
        local lowerPlayer = string.lower(p.Name)
        if string.find(lowerPlayer, lowerName) then
            return p
        elseif string.find(string.lower(p.DisplayName), lowerName) then
            return p
        end
    end
end

