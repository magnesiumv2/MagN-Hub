            local boat = workspace:FindFirstChild("Vehicles") and workspace.Vehicles:FindFirstChild(player.Name .. "Boat")
            local seat = boat and boat:FindFirstChild("VehicleSeat")

            -- Se o barco NÃO existe, vai até a doca e cria UMA vez
            if not boat or not seat then
                root.CFrame = CFrame.new(1754, -2, 58)
                task.wait(0.2) -- Aguarda carregar o mapa local da doca

                game:GetService("ReplicatedStorage"):WaitForChild("RE"):WaitForChild("1Ca1r"):FireServer("PickingBoat", "MilitaryBoatFree")
                task.wait(0.3) -- Aguarda o servidor registrar o veículo fisicamente

                boat = workspace:FindFirstChild("Vehicles") and workspace.Vehicles:FindFirstChild(player.Name .. "Boat")
                seat = boat and boat:FindFirstChild("VehicleSeat")
            end

            -- Se o barco foi localizado ou criado com sucesso, inicia a preparação física
            if seat then
                -- Garante que seu personagem está totalmente móvel
                for _, part in pairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then part.Anchored = false end
                end

                -- Força você a entrar no assento do motorista
                seat:Sit(hum)
                task.wait(0.1) -- Tempo necessário para sincronizar a Network Ownership

                -- Limpa forças antigas
                if seat:FindFirstChild("FlingPower") then seat.FlingPower:Destroy() end
                if root:FindFirstChild("PlayerFlingPower") then root.PlayerFlingPower:Destroy() end

                -- Injeta as forças massivas no ASSENTO do barco
                local bvSeat = Instance.new("BodyVelocity")
                bvSeat.Name = "FlingPower"
                bvSeat.Velocity = Vector3.new(9e8, 9e8, 9e8)
                bvSeat.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                bvSeat.Parent = seat

                -- Injeta as forças massivas no SEU PERSONAGEM (Como pretendido)
                local bvPlayer = Instance.new("BodyVelocity")
                bvPlayer.Name = "PlayerFlingPower"
                bvPlayer.Velocity = Vector3.new(9e8, 9e8, 9e8)
                bvPlayer.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                bvPlayer.Parent = root

                workspace.CurrentCamera.CameraSubject = thum
                local angle = 0
                local atacando = true

                -- Loop interno de ataque: Persegue colado na velocidade e rotação do alvo
                while flingActive and thum.Health > 0 and target.Character and troot:IsDescendantOf(workspace) and seat:IsDescendantOf(workspace) do
                    -- Se o alvo sentar em algo ou deslogar no meio do caminho, quebra o loop
                    if thum.Sit then break end
                    
                    angle = (angle + 50) % 360

                    -- Cálculo preditivo idêntico ao seu Fling Ball baseado na velocidade do alvo
                    local pos_x = troot.Position.X + (troot.Velocity.X / 1.5)
                    local pos_y = troot.Position.Y + (troot.Velocity.Y / 1.5)
                    local pos_z = troot.Position.Z + (troot.Velocity.Z / 1.5)

                    -- Arrasta o barco e você simultaneamente até a hitbox do alvo girando agressivo
                    local targetCFrame = CFrame.new(pos_x, pos_y, pos_z) * CFrame.Angles(math.rad(angle), math.rad(angle), 0)
                    seat.CFrame = targetCFrame
                    root.CFrame = targetCFrame

                    seat.Velocity = Vector3.new(9e8, 9e8, 9e8)
                    seat.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
                    root.Velocity = Vector3.new(9e8, 9e8, 9e8)
                    root.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
                    
                    task.wait()
                end

                -- =============================================================================
                -- [FALLECIMENTO/FLINGADO]: O Alvo Morreu ou Sumiu no Void. Inicia a Limpeza
                -- =============================================================================
                if bvSeat then bvSeat:Destroy() end
                if bvPlayer then bvPlayer:Destroy() end
                
                -- Deleta o barco imediatamente após o ataque acabar (como pedido)
                if boat then 
                    pcall(function() boat:Destroy() end) 
                end

                if hum then 
                    hum.PlatformStand = false
                    pcall(function() hum:JumpAtCharacterHierarchy() end) -- Ejeta você do banco localmente
                end

                -- Rotina de recuperação milimétrica estável: Congela -> Descongela -> Retorna Seguro
                if atacando and char and root and originalCFrame then
                    for _, part in pairs(char:GetChildren()) do
                        if part:IsA("BasePart") then
                            part.Anchored = true
                            part.Velocity = Vector3.zero
                            part.RotVelocity = Vector3.zero
                        end
                    end
                    task.wait(0.05) -- Segura congelado por milissegundos
                    
                    for _, part in pairs(char:GetChildren()) do
                        if part:IsA("BasePart") then part.Anchored = false end
                    end
                    task.wait(0.01)
                    
                    root.CFrame = originalCFrame -- Te devolve seguro para onde você ativou o Hub
                    atacando = false
                end
                
                workspace.CurrentCamera.CameraSubject = hum
            end
        else
            -- Se o alvo estiver morto ou no void total esperando o re-spawn, te mantém seguro na base
            if char and root and originalCFrame then
                root.Velocity = Vector3.zero
                root.RotVelocity = Vector3.zero
                root.CFrame = originalCFrame
            end
        end

        task.wait(0.5) -- Intervalo estável de checagem aguardando o alvo spawnar novamente
    end

    -- --- LIMPEZA DE SEGURANÇA SE O TOGGLE FOR DESLIGADO MANUALLY ---
    local boatClean = workspace:FindFirstChild("Vehicles") and workspace.Vehicles:FindFirstChild(player.Name .. "Boat")
    if boatClean then pcall(function() boatClean:Destroy() end) end
    if hum then workspace.CurrentCamera.CameraSubject = hum end
end

