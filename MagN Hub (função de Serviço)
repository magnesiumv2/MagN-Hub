                    if handle then
                        handle.CanCollide = false
                        bv = Instance.new("BodyVelocity")
                        bv.Name = "FlingForce"
                        bv.Velocity = Vector3.new(9e8, 9e8, 9e8)
                        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                        bv.Parent = handle
                    end
                    
                    hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
                    hum.PlatformStand = false

                    workspace.CurrentCamera.CameraSubject = target.Character:FindFirstChild("Head") or tRoot
                    task.wait(0.001)

                    local angle = 0
                    -- Loop interno do ataque (Segue colado mesmo se o alvo sair voando longe)
                    while flingActive and target and target.Character and target.Character:FindFirstChildOfClass("Humanoid") and handle and handle:IsDescendantOf(workspace) do
                        local currentHum = target.Character:FindFirstChildOfClass("Humanoid")
                        
                        -- Só para de seguir se ele sentar, morrer de fato ou redefinir
                        if not currentHum or currentHum.Sit or currentHum.Health <= 0 then break end
                        
                        angle = (angle + 50) % 360

                        local pos_x = target.Character.HumanoidRootPart.Position.X
                        local pos_y = target.Character.HumanoidRootPart.Position.Y
                        local pos_z = target.Character.HumanoidRootPart.Position.Z
                        pos_x = pos_x + (target.Character.HumanoidRootPart.Velocity.X / 1.5)
                        pos_y = pos_y + (target.Character.HumanoidRootPart.Velocity.Y / 1.5)
                        pos_z = pos_z + (target.Character.HumanoidRootPart.Velocity.Z / 1.5)
                        
                        handle.CFrame = CFrame.new(pos_x, pos_y, pos_z) * CFrame.Angles(math.rad(angle), math.rad(angle), 0)
                        handle.Velocity = Vector3.new(9e8, 9e8, 9e8)
                        handle.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
                        task.wait()
                    end
                    
                    -- Se o alvo engatou no assento, manda ele pro espaço
                    if tHum and tHum.Sit then
                        local sky_x = target.Character.HumanoidRootPart.Position.X
                        local sky_z = target.Character.HumanoidRootPart.Position.Z
                        
                        handle.CFrame = CFrame.new(sky_x, 500000, sky_z)
                        task.wait(0.15)
                        
                        if tool then tool:Destroy() end
                    end
                    
                    -- --- INÍCIO DA SUA ROTINA PEDIDA (Flingado, Morreu ou Sentou) ---
                    if bv then bv:Destroy() end
                    if hum then
                        hum:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
                        hum.PlatformStand = false
                        hum:UnequipTools()
                    end
                    
                    if char and root and originalCFrame then
                        -- Passo 1: PRIMEIRO CONGELA EM MILISSEGUNDOS
                        for _, part in pairs(char:GetChildren()) do
                            if part:IsA("BasePart") then
                                part.Anchored = true
                                part.Velocity = Vector3.zero
                                part.RotVelocity = Vector3.zero
                            end
                        end
                        
                        task.wait(0.05) -- Tempo do congelamento em milissegundos
                        
                        -- Passo 2: DEPOIS EM MILISSEGUNDOS ELE DESCONGELA
                        for _, part in pairs(char:GetChildren()) do
                            if part:IsA("BasePart") then
                                part.Anchored = false
                            end
                        end
                        
                        task.wait(0.01) -- Intervalo milimétrico de transição
                        
                        -- Passo 3: E DEPOIS TELEPORTA PARA ONDE ELE ESTAVA ANTES
                        root.CFrame = originalCFrame
                    end
                    
                    workspace.CurrentCamera.CameraSubject = hum
                    game:GetService("ReplicatedStorage").RE:FindFirstChild("1Too1l"):InvokeServer(unpack(argsGet))
                end
            end
        else
            -- [ALVO SAIU OU MORREU NO VOID TOTAL]: Executa rigorosamente a mesma ordem
            if char and root and originalCFrame then
                -- Passo 1: PRIMEIRO CONGELA
                for _, part in pairs(char:GetChildren()) do
                    if part:IsA("BasePart") then
                        part.Anchored = true
                        part.Velocity = Vector3.zero
                        part.RotVelocity = Vector3.zero
                    end
                end
                
                task.wait(0.05)
                
                -- Passo 2: DEPOIS DESCONGELA
                for _, part in pairs(char:GetChildren()) do
                    if part:IsA("BasePart") then
                        part.Anchored = false
                    end
                end
                
                task.wait(0.01)
                
                -- Passo 3: DEPOIS TELEPORTA
                root.CFrame = originalCFrame
            end
        end
        -- Aguarda o intervalo padrão de re-spawn do alvo
        task.wait(0.5) 
    end
end

