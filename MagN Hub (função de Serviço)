        if tHum and tHum.Sit and handle then
            -- Reduz as forças violentas para trazê-lo de maneira firme e estável
            handle.Velocity = Vector3.zero
            handle.RotVelocity = Vector3.zero
            if bv then bv:Destroy() end
            
            -- Puxa o cabo da ferramenta trazendo o personagem alvo direto para onde você está
            handle.CFrame = originalCFrame * CFrame.new(0, 2, -5)
            task.wait(0.3)
            
            if tool then tool:Destroy() end
        end
        
        -- --- ROTINA DE RECUPERAÇÃO DO SEU REPOSITÓRIO ---
        if hum then
            hum:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
            hum.PlatformStand = false
            hum:UnequipTools()
        end
        
        if char and root and originalCFrame then
            -- Passo 1: Congela
            for _, part in pairs(char:GetChildren()) do
                if part:IsA("BasePart") then
                    part.Anchored = true
                    part.Velocity = Vector3.zero
                    part.RotVelocity = Vector3.zero
                end
            end
            task.wait(0.05)
            
            -- Passo 2: Descongela
            for _, part in pairs(char:GetChildren()) do
                if part:IsA("BasePart") then
                    part.Anchored = false
                end
            end
            task.wait(0.01)
            
            -- Passo 3: Teleporta de volta
            root.CFrame = originalCFrame
        end
        
        workspace.CurrentCamera.CameraSubject = hum
    end)
end

local function ExecuteKillProp(target)
    local players = game:GetService("Players")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local LocalPlayer = players.LocalPlayer
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    
    if not root or not hum or not target or not target.Character then return end

    local tRoot = target.Character:FindFirstChild("Head")
    local tHum = target.Character:FindFirstChildOfClass("Humanoid")
    if not tRoot or not tHum then return end

    -- Se o alvo já estiver sentado antes de iniciar, cancela
    if tHum.Sit or tHum:GetState() == Enum.HumanoidStateType.Seated then return end

    task.spawn(function()
        -- 1. LIMPEZA INICIAL DE FERRAMENTAS
        local RemoteLimpar = ReplicatedStorage.RE:FindFirstChild("1Clea1rTool1s")
        if RemoteLimpar then
            RemoteLimpar:FireServer("ClearAllTools")
        end
        task.wait(0.01)

        -- 2. Pega a ferramenta oficial PropMaker do jogo
        local argsGet = {
            [1] = "PickingTools",
            [2] = "PropMaker"
        }
        ReplicatedStorage.RE:FindFirstChild("1Too1l"):InvokeServer(unpack(argsGet))
        task.wait(0.05)

        local propMakerTool = LocalPlayer.Backpack:FindFirstChild("PropMaker")
        if propMakerTool then
            propMakerTool.Parent = char
        end
        task.wait(0.05)

        -- Valida o controle de ativação da ferramenta
        local Tool_PropMake = char:FindFirstChild("PropMaker") and char.PropMaker:FindFirstChild("Tool_PropMake")
        if not Tool_PropMake then return end

        -- 3. Dispara o spawn do prop de assentos brancos (WaitingChairs ou similar)
        Tool_PropMake:FireServer("SpawnProp", "WaitingChairs") 
        task.wait(0.15)

        -- 4. RASTREAMENTO DINÂMICO DO REMOTE DO SEU REMOTESPY
        -- Em vez de travar no index [16], o script busca de forma inteligente na pasta WorkspaceCom
        local RemoteCFrameReal = nil
        local pastaWorkspaceCom = workspace:FindFirstChild("WorkspaceCom")
        
        if pastaWorkspaceCom then
            -- Varre todas as subpastas de itens (ex: 001_TrafficCones, 002_WaitingChairs, etc.)
            for _, subPasta in ipairs(pastaWorkspaceCom:GetChildren()) do
                -- Procura em cada item da lista pelo Remote "SetCurrentCFrame"
                for _, item in ipairs(subPasta:GetChildren()) do
                    if item:FindFirstChild("SetCurrentCFrame") then
                        RemoteCFrameReal = item.SetCurrentCFrame
                        break
                    end
                end
                if RemoteCFrameReal then break end
            end
        end

        -- Se o script não achar o Remote dinamicamente, usa o caminho exato do seu log como Fallback
        if not RemoteCFrameReal and pastaWorkspaceCom then
            pcall(function()
                local pastaCones = pastaWorkspaceCom:FindFirstChild("001_TrafficCones")
                local itensCones = pastaCones and pastaCones:GetChildren()
                if itensCones and itensCones[16] then
                    RemoteCFrameReal = itensCones[16]:FindFirstChild("SetCurrentCFrame")
                end
            end)
        end

        if not RemoteCFrameReal then return end -- Encerra se a rede do prop não foi achada

        -- Localiza o modelo do prop na Workspace para desativar colisões locais
        local meuProp = workspace:FindFirstChild(LocalPlayer.Name .. "Prop") 
            or workspace:FindFirstChild("Props") and workspace.Props:FindFirstChild(LocalPlayer.Name)
            
        if meuProp then
            for _, part in pairs(meuProp:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end

        local angle = 0
        -- 5. LOOP DE PERSEGUIÇÃO: Atualiza a posição via CFrame e dispara o seu Remote de rede real
        while target and target.Character and target.Character:FindFirstChildOfClass("Humanoid") do
            local currentHum = target.Character:FindFirstChildOfClass("Humanoid")
            
            -- Interrompe o loop se o alvo sentar, morrer ou se o botão geral desligar
            if not currentHum or currentHum.Sit or currentHum.Health <= 0 or not flingActive then break end
            
            angle = (angle + 50) % 360

            local pos_x = target.Character.HumanoidRootPart.Position.X
            local pos_y = target.Character.HumanoidRootPart.Position.Y
            local pos_z = target.Character.HumanoidRootPart.Position.Z
            
            -- Cálculo de compensação de movimento (Prediction / 1.5)
            local alvoVelocidade = target.Character.HumanoidRootPart.AssemblyLinearVelocity or target.Character.HumanoidRootPart.Velocity
            pos_x = pos_x + (alvoVelocidade.X / 1.5)
            pos_y = pos_y + (alvoVelocidade.Y / 1.5)
            pos_z = pos_z + (alvoVelocidade.Z / 1.5)
            
            -- Calcula a posição rotacionando rente às pernas do alvo
            local novaPosicao = CFrame.new(pos_x, pos_y - 1, pos_z) * CFrame.Angles(0, math.rad(angle), 0)
            
            -- DISPARA O SEU REMOTE DO REMOTESPY (Atualiza o prop para o servidor seguir o alvo)
            RemoteCFrameReal:FireServer(novaPosicao)
            
            task.wait()
        end
        
        -- =============================================================================
        -- [MECÂNICA DE EXECUÇÃO: TELEPORTE FINAL PARA 1, -889, -1 E DESTRUIÇÃO BRUTA]
        -- =============================================================================
        if tHum and tHum.Sit and RemoteCFrameReal then
            task.wait(0.01)

            -- Coordenada subterrânea profunda solicitada
            local coordenadaFinal = CFrame.new(1, -889, -1)
            
            -- Força o teletransporte final do prop com o alvo acoplado usando seu remote
            RemoteCFrameReal:FireServer(coordenadaFinal)
            task.wait(0.05) -- Tempo para processar o empurrão de rede

            -- Deleta o prop localmente
            if meuProp then meuProp:Destroy() end
            
            -- Aciona o seu remote de limpeza geral de ferramentas para apagar rastros do mapa
            if RemoteLimpar then
                RemoteLimpar:FireServer("ClearAllTools")
            end
            
            -- FIM DO SCRIPT: O fluxo encerra aqui, sem comandos de recall para manter sua posição travada.
        end
    end)
end

local function ExecuteKillCouch(target)
    local players = game:GetService("Players")
    local player = players.LocalPlayer
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    
    if not root or not hum or not target or not target.Character then return end

    local tRoot = target.Character:FindFirstChild("Head")
    local tHum = target.Character:FindFirstChildOfClass("Humanoid")
    if not tRoot or not tHum then return end

    -- Se o alvo já estiver sentado em algo antes de começar, cancela
    if tHum.Sit or tHum:GetState() == Enum.HumanoidStateType.Seated then return end

    task.spawn(function()
        local originalCFrame = root.CFrame -- SALVA ONDE O BOTÃO FOI CLICADO

        -- Garante que seu corpo está totalmente móvel no início do ataque
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.Anchored = false
            end
        end

        -- 1. Limpa as ferramentas antigas
        local argsClean = {"ClearAllTools"}
        game:GetService("ReplicatedStorage"):WaitForChild("RE"):WaitForChild("1Clea1rTool1s"):FireServer(unpack(argsClean))
        task.wait(0.01)

        -- 2. Pega o Sofá
        local argsGet = {
            [1] = "PickingTools",
            [2] = "Couch"
        }
        game:GetService("ReplicatedStorage").RE:FindFirstChild("1Too1l"):InvokeServer(unpack(argsGet))
        task.wait(0.01)

        local tool = player.Backpack:FindFirstChild("Couch")
        if tool then
            tool.Parent = char
        end
        task.wait(0.01)

        -- Define a altura de destruição para um valor gigante para o sofá não sumir antes da hora
        workspace.FallenPartsDestroyHeight = -999999

        local handle = tool and tool:FindFirstChild("Handle")
        if handle and handle:FindFirstChild("FlingForce") then
            handle.FlingForce:Destroy()
        end

        -- 3. Cria a força na Handle do Sofá para a perseguição
        local bv = nil
        if handle then
            handle.CanCollide = false
            bv = Instance.new("BodyVelocity")
            bv.Name = "FlingForce"
            bv.Velocity = Vector3.new(9e8, 9e8, 9e8)
            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bv.Parent = handle
        end
        
        hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
        hum.PlatformStand = false

        workspace.CurrentCamera.CameraSubject = target.Character:FindFirstChild("Head") or tRoot
        task.wait(0.01)

        local angle = 0
        -- Loop interno do ataque (Segue colado até capturar)
        while target and target.Character and target.Character:FindFirstChildOfClass("Humanoid") and handle and handle:IsDescendantOf(workspace) do
            local currentHum = target.Character:FindFirstChildOfClass("Humanoid")
            
            if not currentHum or currentHum.Sit or currentHum.Health <= 0 then break end
            
            angle = (angle + 50) % 360

            local pos_x = target.Character.HumanoidRootPart.Position.X
            local pos_y = target.Character.HumanoidRootPart.Position.Y
            local pos_z = target.Character.HumanoidRootPart.Position.Z
            pos_x = pos_x + (target.Character.HumanoidRootPart.Velocity.X / 1.5)
            pos_y = pos_y + (target.Character.HumanoidRootPart.Velocity.Y / 1.5)
            pos_z = pos_z + (target.Character.HumanoidRootPart.Velocity.Z / 1.5)
            
            handle.CFrame = CFrame.new(pos_x, pos_y, pos_z) * CFrame.Angles(math.rad(angle), math.rad(angle), 0)
            handle.Velocity = Vector3.new(9e8, 9e8, 9e8)
            handle.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
            task.wait()
        end
        
        -- =============================================================================
        -- [AÇÃO DE ENTREGA NA COORDENADA E DESTRUIÇÃO DO COUCH]
        -- =============================================================================
        if tHum and tHum.Sit and handle then
            if bv then bv:Destroy() end
            handle.Velocity = Vector3.zero
            handle.RotVelocity = Vector3.zero
            task.wait(0.01)

            -- Teleporta tudo junto para a sua coordenada solicitada
            local coordenadaEspecifica = CFrame.new(1, -332, -1)
            root.CFrame = coordenadaEspecifica
            handle.CFrame = coordenadaEspecifica
            task.wait(0.05) 

            -- Retorna a altura de destruição nativa para -500
            workspace.FallenPartsDestroyHeight = -500
            task.wait(0.01)

            -- APAGA O COUCH PRIMEIRO (O alvo perde a base e cai no void)
            if tool then 
                tool:Destroy() 
            end
            task.wait(0.05) 
        end
        
        -- --- ROTINA DE RECUPERAÇÃO SEM CONGELAMENTO ---
        if hum then
            hum:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
            hum.PlatformStand = false
            hum:UnequipTools()
        end
        
        -- TELEPORTA DIRETAMENTE DE VOLTA (Instantâneo para onde o botão foi clicado)
        if root and originalCFrame then
            root.CFrame = originalCFrame
        end
        
        workspace.CurrentCamera.CameraSubject = hum
        
        -- Limpeza final de segurança no servidor do Brookhaven
        task.wait(0.1)
        game:GetService("ReplicatedStorage").RE["1Clea1rTool1s"]:FireServer("ClearAllTools")
    end)
end

