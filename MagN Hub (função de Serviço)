-- Função Auxiliar do Fling Ball (Otimizada e com Física Estabilizada)
local function ExecuteFlingBall(target)
    local players = game:GetService("Players")
    local player = players.LocalPlayer
    local character = player.Character or player.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid")
    local backpack = player:WaitForChild("Backpack")
    local ServerBalls = workspace.WorkspaceCom:WaitForChild("001_SoccerBalls")

    -- Função interna para pegar a bola caso você não tenha
    local function GetBall()
        if not backpack:FindFirstChild("SoccerBall") then
            game:GetService("ReplicatedStorage").RE:FindFirstChild("1Too1l"):InvokeServer("PickingTools", "SoccerBall")
        end
        repeat task.wait() until backpack:FindFirstChild("SoccerBall")
        backpack.SoccerBall.Parent = character
        repeat task.wait() until ServerBalls:FindFirstChild("Soccer" .. player.Name)
        character.SoccerBall.Parent = backpack
        return ServerBalls:FindFirstChild("Soccer" .. player.Name)
    end

    -- Pega ou localiza a bola física no workspace
    local Ball = ServerBalls:FindFirstChild("Soccer" .. player.Name) or GetBall()
    
    if Ball and target ~= player then
        local tchar = target.Character
        local troot = tchar and tchar:FindFirstChild("HumanoidRootPart")
        local thum = tchar and tchar:FindFirstChildOfClass("Humanoid")

        if troot and thum and thum.Health > 0 then
            -- Configurações de física pesada essenciais para dar o empurrão (Fling)
            Ball.CanCollide = true 
            Ball.Massless = false  
            Ball.CustomPhysicalProperties = PhysicalProperties.new(100, 100, 0, 100, 100) 

            -- Força o ganho de propriedade de rede (Network Ownership)
            if sethiddenproperty then
                sethiddenproperty(Ball, "NetworkOwnershipRule", Enum.NetworkOwnershipRule.Manual)
            elseif Ball.SetNetworkOwner then
                pcall(function() Ball:SetNetworkOwner(player) end)
            end

            -- Limpa forças antigas na bola
            if Ball:FindFirstChildWhichIsA("BodyVelocity") then
                Ball:FindFirstChildWhichIsA("BodyVelocity"):Destroy()
            end

            -- Cria a força física diretamente na bola (Velocidade reajustada para impacto máximo)
            local bv = Instance.new("BodyVelocity")
            bv.Name = "FlingPower"
            bv.Velocity = Vector3.new(9e8, 9e8, 9e8)
            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bv.Parent = Ball

            workspace.CurrentCamera.CameraSubject = thum
            local angle = 0
            
            -- EXECUÇÃO DIRETA: Roda um ciclo rápido e agressivo na CFrame do alvo
            while flingActive and thum.Health > 0 and tchar:IsDescendantOf(workspace) and target.Parent == players do
                angle = (angle + 50) % 360
                
                -- Previsão avançada de movimento baseada na velocidade do alvo
                local pos_x = troot.Position.X + (troot.Velocity.X / 1.5)
                local pos_y = troot.Position.Y - 1.2 -- Posiciona exatamente nos pés/pernas do alvo para dar o Fling
                local pos_z = troot.Position.Z + (troot.Velocity.Z / 1.5)
                
                -- Teleporta e rotaciona a bola freneticamente na CFrame calculada
                Ball.CFrame = CFrame.new(pos_x, pos_y, pos_z) * CFrame.Angles(math.rad(angle), math.rad(angle), 0)
                
                -- Injeta a velocidade física na bola para registrar o impacto mecânico
                Ball.Velocity = Vector3.new(9e8, 9e8, 9e8)
                Ball.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
                task.wait() 
            end
            
            -- Limpeza pós-ataque caso o loop seja quebrado
            if bv then bv:Destroy() end
            Ball.Velocity = Vector3.zero
            Ball.RotVelocity = Vector3.zero
            workspace.CurrentCamera.CameraSubject = humanoid
        end
    end
end

-- --- MÉTODO 2: FLING COUCH (Força no sofá, sem soltar da mão, puxando o personagem junto) ---
local function ExecuteFlingCouch(target, originalCFrame)
    local players = game:GetService("Players")
    local player = players.LocalPlayer
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")

    if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") and target.Character:FindFirstChildOfClass("Humanoid") and target.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
        local tHum = target.Character:FindFirstChildOfClass("Humanoid")
        
        if not tHum.Sit then
            local tRoot = target.Character:FindFirstChild("Head")
            
            if root and tRoot and hum then
                -- 1. Limpa as ferramentas antigas
                local argsClean = {"ClearAllTools"}
                game:GetService("ReplicatedStorage"):WaitForChild("RE"):WaitForChild("1Clea1rTool1s"):FireServer(unpack(argsClean))
                task.wait(0.0001)

                -- 2. Pega o Sofá
                local argsGet = {
                    [1] = "PickingTools",
                    [2] = "Couch"
                }
                game:GetService("ReplicatedStorage").RE:FindFirstChild("1Too1l"):InvokeServer(unpack(argsGet))
                task.wait(0.0001)

                local tool = player.Backpack:FindFirstChild("Couch")
                if tool then
                    tool.Parent = char
                end
                task.wait(0.0001)

                workspace.FallenPartsDestroyHeight = -999999

                local handle = tool:FindFirstChild("Handle")
                if handle and handle:FindFirstChild("FlingForce") then
                    handle.FlingForce:Destroy()
                end

                -- 3. Cria a força na Handle do Sofá (Sem soltar da mão)
                local bv = nil
                if handle then
                    handle.CanCollide = false
                    bv = Instance.new("BodyVelocity")
                    bv.Name = "FlingForce"
                    bv.Velocity = Vector3.new(9e8, 9e8, 9e8)
                    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                    bv.Parent = handle
                end
                
                hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
                hum.PlatformStand = false

                workspace.CurrentCamera.CameraSubject = target.Character:FindFirstChild("Head") or tRoot
                task.wait(0.001)

                -- Simula o F (Pressiona e Solta)
                local vim = game:GetService("VirtualInputManager")
                vim:SendKeyEvent(true, Enum.KeyCode.F, false, game)
                task.wait(0.0001)
                vim:SendKeyEvent(false, Enum.KeyCode.F, false, game)

                local angle = 0
                -- Loop interno do ataque
                while flingActive and target and target.Character and target.Character:FindFirstChildOfClass("Humanoid") and handle and handle:IsDescendantOf(workspace) do
                    local currentHum = target.Character:FindFirstChildOfClass("Humanoid")
                    
                    -- Se o alvo sentar, morrer ou bugar, quebra o loop de rotação
                    if not currentHum or currentHum.Sit or currentHum.Health <= 0 then break end
                    
                    angle = (angle + 50) % 360

                    local pos_x = target.Character.HumanoidRootPart.Position.X
                    local pos_y = target.Character.HumanoidRootPart.Position.Y
                    local pos_z = target.Character.HumanoidRootPart.Position.Z
                    pos_x = pos_x + (target.Character.HumanoidRootPart.Velocity.X / 1.5)
                    pos_y = pos_y + (target.Character.HumanoidRootPart.Velocity.Y / 1.5)
                    pos_z = pos_z + (target.Character.HumanoidRootPart.Velocity.Z / 1.5)
                    
                    handle.CFrame = CFrame.new(pos_x, pos_y, pos_z) * CFrame.Angles(math.rad(angle), math.rad(angle), 0)
                    handle.Velocity = Vector3.new(9e8, 9e8, 9e8)
                    handle.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
                    task.wait()
                end
                
                -- Se o alvo sentou, manda ele direto pro espaço!
                if tHum and tHum.Sit then
                    local sky_x = target.Character.HumanoidRootPart.Position.X
                    local sky_z = target.Character.HumanoidRootPart.Position.Z
                    
                    handle.CFrame = CFrame.new(sky_x, 500000, sky_z)
                    task.wait(0.15)
                    
                    if tool then tool:Destroy() end
                end
                
                -- --- LIMPEZA E RETORNO FIXO ---
                if bv then bv:Destroy() end
                if hum then
                    hum:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
                    hum.PlatformStand = false
                    hum:UnequipTools()
                end
                
                if root and originalCFrame then
                    root.CFrame = originalCFrame
                    for _, part in pairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.Velocity = Vector3.zero
                            part.RotVelocity = Vector3.zero
                        end
                    end
                end
                
                workspace.CurrentCamera.CameraSubject = hum
                game:GetService("ReplicatedStorage").RE:FindFirstChild("1Too1l"):InvokeServer(unpack(argsGet))
            end
        end
    end
end

