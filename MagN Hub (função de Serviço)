local currentMethod = "Ball" -- Método padrão inicial
local flingActive = false

local function ExecuteFlingBall(target, originalCFrame)
    local players = game:GetService("Players")
    local player = players.LocalPlayer
    
    -- O loop principal roda continuamente enquanto o seu Toggle (flingActive) estiver ligado
    while flingActive and target and target.Parent == players do
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local backpack = player:WaitForChild("Backpack")
        local ServerBalls = workspace.WorkspaceCom:WaitForChild("001_SoccerBalls")

        -- Sua lógica exata para pegar a bola
        local function GetBall()
            if not backpack:FindFirstChild("SoccerBall") then
                game:GetService("ReplicatedStorage").RE:FindFirstChild("1Too1l"):InvokeServer("PickingTools", "SoccerBall")
            end
            repeat task.wait() until backpack:FindFirstChild("SoccerBall")
            backpack.SoccerBall.Parent = char
            repeat task.wait() until ServerBalls:FindFirstChild("Soccer" .. player.Name)
            char.SoccerBall.Parent = backpack
            return ServerBalls:FindFirstChild("Soccer" .. player.Name)
        end

        local Ball = ServerBalls:FindFirstChild("Soccer" .. player.Name) or GetBall()
        Ball.CanCollide = false
        Ball.Massless = true
        Ball.CustomPhysicalProperties = PhysicalProperties.new(0.0001, 0, 0)

        -- Verifica se o alvo tem um personagem vivo e válido
        if target.Character and target.Character:FindFirstChild("HumanoidRootPart") and target.Character:FindFirstChildOfClass("Humanoid") and target.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
            local tchar = target.Character
            local thum = tchar:FindFirstChildOfClass("Humanoid")

            -- Remove forças antigas da bola para não acumular bugs
            for _, child in pairs(Ball:GetChildren()) do
                if child:IsA("BodyVelocity") or child:IsA("BodyAngularVelocity") then
                    child:Destroy()
                end
            end

            -- Adiciona força linear extrema
            local bv = Instance.new("BodyVelocity")
            bv.Name = "FlingPower"
            bv.Velocity = Vector3.new(9e8, 9e8, 9e8)
            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bv.P = 9e900
            bv.Parent = Ball

            -- Adiciona força de rotação extrema para aumentar o dano do Fling física
            local bav = Instance.new("BodyAngularVelocity")
            bav.Name = "FlingSpin"
            bav.AngularVelocity = Vector3.new(9e8, 9e8, 9e8)
            bav.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
            bav.P = 9e900
            bav.Parent = Ball

            workspace.CurrentCamera.CameraSubject = thum
            
            -- Loop de ataque que teleporta a bola por TODAS as partes do inimigo constantemente
            while flingActive and thum.Health > 0 and tchar:IsDescendantOf(workspace) and target.Parent == players do
                -- Usamos GetDescendants para pegar absolutamente tudo (Braços, pernas, MeshParts de R15, acessórios, etc.)
                for _, v in pairs(tchar:GetDescendants()) do
                    if not flingActive or thum.Health <= 0 then break end
                    
                    -- Modificado: Verifica se é uma BasePart e se não está ancorada. 
                    -- Removido o filtro "v.CanCollide" para garantir que acerte mesmo se o alvo tiver partes sem colisão ativada.
                    if v:IsA("BasePart") and not v.Anchored and v.Name ~= "HumanoidRootPart" then
                        Ball.CFrame = v.CFrame
                        Ball.Velocity = Vector3.new(9e8, 9e8, 9e8)
                        Ball.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
                        task.wait(1/2000) -- Seu timing exato do script original
                    end
                end
                task.wait()
            end
            
            -- --- LIMPEZA APÓS O ATAQUE ---
            if bv then bv:Destroy() end
            if bav then bav:Destroy() end
            Ball.Velocity = Vector3.zero
            Ball.RotVelocity = Vector3.zero
            
            -- Apenas te teleporta de volta sem congelar
            if root and originalCFrame then
                root.CFrame = originalCFrame
            end
            
            workspace.CurrentCamera.CameraSubject = hum
        else
            -- [ALVO NO LIMBO/SPAWN]: Apenas te teleporta para onde o botão foi ligado
            if root and originalCFrame then
                root.CFrame = originalCFrame
            end
        end
        -- Intervalo padrão seguro e estável aguardando o re-spawn do alvo
        task.wait(0.5) 
    end
end

