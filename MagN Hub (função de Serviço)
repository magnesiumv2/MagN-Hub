-- Função auxiliar que aplica os IDs no seu personagem para esticar a textura até o céu
local function aplicarGlitchSkybox(shirtId, pantsId, torsoId)
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    
    if humanoid then
        local description = Players:GetHumanoidDescriptionFromUserId(LocalPlayer.UserId)
        
        description.Shirt = shirtId or 0
        description.Pants = pantsId or 0
        
        -- ID do torso clássico que quebra a escala física do avatar no Brookhaven
        description.Torso = torsoId or 6400494 
        description.LeftArm = torsoId or 6400494
        description.RightArm = torsoId or 6400494
        
        humanoid:ApplyDescription(description)
    end
end

-- Função para limpar o glitch e fazer você voltar ao seu corpo normal
