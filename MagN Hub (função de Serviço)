    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")

    -- Proteção inicial: se o botão não estiver ligado, cancela
    if not flingActive or not root or not hum then return end

    -- =============================================================================
    -- [BLOCO DE EXECUÇÃO ÚNICA]: Roda estritamente UMA vez ao ativar a função
    -- =============================================================================
    root.CFrame = CFrame.new(1754, -2, 58)
    task.wait(0.2) -- Aumentado levemente para garantir o carregamento do mapa/doca

    game:GetService("ReplicatedStorage"):WaitForChild("RE"):WaitForChild("1Ca1r"):FireServer("PickingBoat", "MilitaryBoatFree")
    task.wait(0.3) -- Tempo necessário para o veículo registrar fisicamente no Workspace

    -- Localiza o veículo gerado uma única vez
    local boat = workspace:FindFirstChild("Vehicles") and workspace.Vehicles:FindFirstChild(player.Name .. "Boat")
    local seat = boat and boat:FindFirstChild("VehicleSeat")
    local bv = nil

    if seat then
        -- Força você a entrar no assento do motorista uma única vez
        seat:Sit(hum)
        task.wait(0.1) -- Sincroniza a propriedade física de rede (Network Ownership)

        if seat:FindFirstChild("FlingPower") then
            seat.FlingPower:Destroy()
        end

        -- Injeta a força massiva linear no assento do barco
        bv = Instance.new("BodyVelocity")
        bv.Name = "FlingPower"
        bv.Velocity = Vector3.new(9e8, 9e8, 9e8)
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.Parent = seat

        local atacando = false -- Nova trava para controlar o estado pós-ataque

        -- =============================================================================
        -- [LOOP PRINCIPAL DE FOCO]: Fica monitorando o alvo continuamente sem recriar o barco
        -- =============================================================================
        while flingActive and target and target.Parent == players and boat:IsDescendantOf(workspace) and seat:IsDescendantOf(workspace) do
            char = player.Character
            root = char and char:FindFirstChild("HumanoidRootPart")
            hum = char and char:FindFirstChildOfClass("Humanoid")

            -- Se o alvo estiver vivo e válido, inicia a perseguição estilo Fling Ball
            if target.Character and target.Character:FindFirstChild("HumanoidRootPart") and target.Character:FindFirstChildOfClass("Humanoid") and target.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
                local troot = target.Character.HumanoidRootPart
                local thum = target.Character:FindFirstChildOfClass("Humanoid")
                
                workspace.CurrentCamera.CameraSubject = thum
                local angle = 0
                atacando = true -- Sinaliza que o ataque começou

                -- Loop interno do ataque agressivo (Gira e gruda na velocidade do alvo)
                while flingActive and thum.Health > 0 and target.Character and troot:IsDescendantOf(workspace) and seat:IsDescendantOf(workspace) do
                    angle = (angle + 50) % 360

                    -- Cálculo preditivo idêntico ao Fling Ball
                    local pos_x = troot.Position.X + (troot.Velocity.X / 1.5)
                    local pos_y = troot.Position.Y + (troot.Velocity.Y / 1.5)
                    local pos_z = troot.Position.Z + (troot.Velocity.Z / 1.5)

                    -- Arrasta você e o barco até o alvo
                    seat.CFrame = CFrame.new(pos_x, pos_y, pos_z) * CFrame.Angles(math.rad(angle), math.rad(angle), 0)
                    seat.Velocity = Vector3.new(9e8, 9e8, 9e8)
                    seat.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
                    task.wait()
                end

                -- --- CORTE DE RECUPERAÇÃO APÓS ALVO MORRER/FLINGAR ---
                if seat then
                    seat.Velocity = Vector3.zero
                    seat.RotVelocity = Vector3.zero
                end

                if hum then 
                    hum.PlatformStand = false
                    pcall(function() hum:JumpAtCharacterHierarchy() end) -- Te tira do banco do carro
                end

                -- Executa a rotina exata: Congela -> Descongela -> Teleporta (APENAS SE ESTAVA ATACANDO)
                if atacando and char and root and originalCFrame then
                    for _, part in pairs(char:GetChildren()) do
                        if part:IsA("BasePart") then
                            part.Anchored = true
                            part.Velocity = Vector3.zero
                            part.RotVelocity = Vector3.zero
                        end
                    end
                    task.wait(0.05) -- Milissegundos congelado
                    
                    for _, part in pairs(char:GetChildren()) do
                        if part:IsA("BasePart") then
                            part.Anchored = false
                        end
                    end
                    task.wait(0.01) -- Milissegundos de transição
                    root.CFrame = originalCFrame -- Teleporta de volta
                    atacando = false -- Reseta a trava
                end
                
                workspace.CurrentCamera.CameraSubject = hum
            else
                -- [ALVO NO LIMBO/SPAWN]: Removeu-se o spam de teletransporte infinito daqui.
                -- Agora o script apenas mantém você seguro e aguarda o alvo reviver.
                if seat then
                    seat.Velocity = Vector3.zero
                    seat.RotVelocity = Vector3.zero
                end
            end
            
            -- Se o alvo estiver morto ou no void, garante que você volte para o banco para o próximo round
            if flingActive and hum and seat and not hum.Sit then
                seat:Sit(hum)
            end

            task.wait(0.2) -- Intervalo rápido e estável verificando se o alvo voltou à vida
        end -- Fim do loop while flingActive
    end

    -- --- LIMPEZA COMPLETA AO DESLIGAR O TOGGLE MANUAMENTE ---
    if bv then bv:Destroy() end
    if boat then pcall(function() boat:Destroy() end) end
    if hum then workspace.CurrentCamera.CameraSubject = hum end
end

