local RunService = game:GetService("RunService")

local antiFlingActive = false
local physicsConnection = nil
local folderSignalConnection = nil

-- Tabela para gerenciar as partes da pasta que perderão a colisão
local trackedSoccerParts = {}

-- Caminho direto para a pasta alvo
local function getSoccerFolder()
    local workspaceCom = workspace:FindFirstChild("WorkspaceCom")
    if workspaceCom then
        return workspaceCom:FindFirstChild("001_SoccerBalls")
    end
    return nil
end

-- Adiciona a parte na lista de monitoramento de colisão se ela pertencer à pasta
local function checkPart(item)
    if not antiFlingActive or not item:IsA("BasePart") then return end
    
    local soccerFolder = getSoccerFolder()
    if soccerFolder and item:IsDescendantOf(soccerFolder) then
        trackedSoccerParts[item] = true
    end
end

-- Aplica CanCollide = false continuamente na fase física do motor (Garante que nada reative)
local function applyNoCollision()
    for item in pairs(trackedSoccerParts) do
        if item and item.Parent then
            item.CanCollide = false
        else
            trackedSoccerParts[item] = nil -- Limpeza automática se o objeto for deletado
        end
    end
end

-- Chamada do Toggle integrada à sua interface existente
Anti:AddToggle({
    Name = "Anti Fling Ball",
    Default = false,
    Callback = function(Value)
        antiFlingActive = Value
        
        if antiFlingActive then
            table.clear(trackedSoccerParts)
            
            local soccerFolder = getSoccerFolder()
            if soccerFolder then
                -- 1. Capta tudo o que já está dentro da pasta no momento em que ligou
                for _, item in ipairs(soccerFolder:GetDescendants()) do
                    checkPart(item)
                end
                
                -- 2. Escuta de forma leve apenas a entrada de novos objetos na pasta
                folderSignalConnection = soccerFolder.DescendantAdded:Connect(function(item)
                    task.defer(checkPart, item)
                end)
            end
            
            -- 3. Mantém a colisão desligada sincronizado com o motor de física
            physicsConnection = RunService.Stepped:Connect(applyNoCollision)
        else
            -- Desliga o sistema limpando a memória do Roblox com total segurança
            if physicsConnection then physicsConnection:Disconnect(); physicsConnection = nil end
            if folderSignalConnection then folderSignalConnection:Disconnect(); folderSignalConnection = nil end
            table.clear(trackedSoccerParts)
        end
    end
})

